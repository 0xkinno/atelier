# Atelier Environment Variables

# Storage (Vercel KV / Upstash Redis API credentials)
KV_REST_API_URL="https://example-kv.upstash.io"
KV_REST_API_TOKEN="example_token_here"

# File Upload (Vercel Blob token)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_example"

# Nimiq RPC / Network
NIMIQ_RPC_URL="https://api.nimiq.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Price Feed
COINGECKO_API_URL="https://api.coingecko.com/api/v3"

# JWT / Auth Secret
AUTH_SECRET="atelier-super-secret-jwt-signing-key-32-chars"
